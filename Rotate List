class ListNode:
    def __init__(self, val=0, next=None):
        self.val = val
        self.next = next
class Solution:
    def rotateRight(self, head, k):
        if not head or not head.next or k == 0:
            return head
        length = 1
        last = head
        while last.next:
            last = last.next
            length += 1
        last.next = head
        k = k % length
        steps_to_new_tail = length - k - 1
        new_tail = head  
        for _ in range(steps_to_new_tail):
            new_tail = new_tail.next
        new_head = new_tail.next
        new_tail.next = None
        return new_head
