class Solution:
    def maxValue(self, nums: List[int]) -> List[int]:
        from typing import List
        n = len(nums)
        preMax = [0] * n
        preMax[0] = nums[0]
        for i in range(1, n):
            preMax[i] = max(preMax[i - 1], nums[i])
        ans = [0] * n
        sufMin = float('inf')
        for i in range(n - 1, -1, -1):
            if preMax[i] > sufMin:
                ans[i] = ans[i + 1] if i + 1 < n else preMax[i]
            else:
                ans[i] = preMax[i]
            sufMin = min(sufMin, nums[i])
        return ans
